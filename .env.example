# Copy to .env and fill in secrets:  cp .env.example .env
# Used by both docker-compose (Postgres) and the Go backend (via viper ENV override).

# --- app ---
APP_ENV=local
HTTP_ADDR=:8080
WEB_ORIGIN=http://localhost:5173

# --- postgres (docker-compose) ---
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# --- database (backend + goose) ---
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable

# --- jwt ---
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# --- google oauth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
